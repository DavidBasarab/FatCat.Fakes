<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<DebugType>full</DebugType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<AssemblyOriginatorKeyFile>..\FatCat.Fakes\FakerRelease.snk</AssemblyOriginatorKeyFile>
		<PublicSign>false</PublicSign>
		<SignAssembly>true</SignAssembly>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CSharpier.MsBuild" Version="1.3.0">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="FatCat.Testing" Version="1.0.4" />
		<PackageReference Include="FatCat.Toolkit" Version="1.0.353" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FatCat.Fakes\FatCat.Fakes.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\FatCat.Fakes\FakerRelease.snk">
			<Link>FakerRelease.snk</Link>
		</None>
	</ItemGroup>
</Project>
