<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <DebugType>full</DebugType>
        <LangVersion>latest</LangVersion>
        <AssemblyOriginatorKeyFile>FakerRelease.snk</AssemblyOriginatorKeyFile>
    <VersionPrefix>1.0.31</VersionPrefix>
        <Authors>David Basarab</Authors>
        <PackageTags>unittest;fakes;object</PackageTags>
        <PackageProjectUrl>https://github.com/DavidBasarab/FatCat.Fakes</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/DavidBasarab/FatCat.Fakes</RepositoryUrl>
        <NoWarn>CS8002,CS1700</NoWarn>
        <SignAssembly>true</SignAssembly>
        <TargetFramework>net9.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CSharpier.MsBuild" Version="1.3.0">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="fasterflect" Version="3.0.0" />
    </ItemGroup>
</Project>
